# json.query(text, path) — host-side JSON selection with the jq selection
# subset. Covers: nested field chains, `[]` expansion (arrays and object
# values), root selection via the empty path, missing fields dropping out
# silently, non-array expansion dropping out, a leading '.' tolerated,
# array indexes (including negative), quoted keys containing dots, pipe
# separators, the ignored `?` marker, `..` recursive descent, and null on
# both invalid JSON and malformed paths.
# expect: ok
# stdout:
#   2
#   a
#   b
#   3
#   1
#   dictionary
#   0
#   0
#   42
#   10
#   30
#   7
#   done
#   2
#   plan
#   done
#   invalid-json-null
#   malformed-path-null
# leak: flat
# ownership: balanced

use std.json

def main
    @return Void
do
    let body = '{"task":{"items":[{"name":"a","n":1},{"name":"b","n":2},{"n":3}],"summary":"s"}}'
    let names = json.query(body, 'task.items[].name')!
    print(length(names))
    print(names[0])
    print(names[1])
    let items = json.query(body, 'task.items[]')!
    print(length(items))
    let root = json.query(body, '')!
    print(length(root))
    print(typeOf(root[0]))
    print(length(json.query(body, 'task.missing[].x')!))
    print(length(json.query(body, 'task.summary[]')!))
    let answer = json.query('{"a":{"b":42}}', '.a.b')!
    print(answer[0])
    let jq = '{"ns":[10,20,30],"a.b":{"c":7},"deep":{"status":"plan","sub":{"status":"done"}}}'
    let first = json.query(jq, 'ns[0]')!
    print(first[0])
    let last = json.query(jq, '.ns[-1]')!
    print(last[0])
    let quoted = json.query(jq, '."a.b".c')!
    print(quoted[0])
    let piped = json.query(jq, '.deep | .sub | .status?')!
    print(piped[0])
    let statuses = json.query(jq, '.. | .status?')!
    print(length(statuses))
    print(statuses[0])
    print(statuses[1])
    let bad = json.query('not json', 'a')
    if bad?
        print('unexpected')
    else
        print('invalid-json-null')
    end
    let malformed = json.query(jq, 'ns[1:2]')
    if malformed?
        print('unexpected')
    else
        print('malformed-path-null')
    end
end
