use std.array

# expect: ok
# stdout:
#   true
#   false
#   true
#   false
def main
    @return Void
do
  let xs = [
    1
    2
    3
  ]
  print(array.contains(xs, 2))
  print(array.contains(xs, 99))
  let names = [
    'alice' + ''
    'bob' + ''
  ]
  print(array.contains(names, 'alice'))
  print(array.contains(names, 'eve'))
end
