# expect: ok
# stdout:
#   Alice is 30
def describe
    @param age Int
    @param name String
    @return String
do
    name + ' is ' + toString(age)
end

test describe
    it 'formats'
        assert.equal(describe(name: 'Alice', age: 30), 'Alice is 30')
    end
end

def main
    @return Void
do
    print(describe(name: 'Alice', age: 30))
end
