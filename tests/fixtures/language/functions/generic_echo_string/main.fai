# expect: ok
# stdout:
#   hello
# Generic identity function with a String argument — same
# regression guard as `generic_echo_int`, but with a reference-
# typed value so the heap/NaN-box path is also covered.
def echo
    @type T
    @param v $T
    @return $T
do
  v
end

def main
    @return Void
do
  print(echo('hello'))
end

test echo
it 'returns its string argument'
  assert.equals(echo('hello'), 'hello')
end
end
