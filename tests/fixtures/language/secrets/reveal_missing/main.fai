# expect: ok
# stdout:
#   caught: true
#   value-free: true

use std.secrets

use std.string

def main
    @return Void
do
    let key = secrets.get('FAI_FIXTURE_REVEAL_UNSET')
    try
        let plaintext = secrets.reveal(key)
        print(plaintext)
    catch e
        print('caught: ' + toString(string.contains(e.message, 'could not be resolved')))
        print('value-free: ' + toString(string.contains(e.message, 'FAI_FIXTURE_REVEAL_UNSET')))
    end
end
