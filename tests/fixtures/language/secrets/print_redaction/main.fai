# expect: ok
# stdout:
#   «secret STRIPE_KEY»
#   «secret STRIPE_KEY»
#   «secret STRIPE_KEY»
#   secret
#   true
# leak: flat
# ownership: balanced

use std.secrets

def main
    @return Void
do
    let key = secrets.get('STRIPE_KEY')
    print(key)
    print(toString(key))
    let copied = copy(key)
    print(copied)
    print(typeOf(key))
    print(secrets.available())
end
