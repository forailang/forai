#   true

use std.secrets

use std.env

use std.file

def main
    @return Void
do
    print(secrets.has('FAI_FIXTURE_SECRET_UNSET'))
    let path = '/tmp/fai_std_secrets_fixture.env'
    file.write(path, 'FAI_FIXTURE_SECRET=hunter2\n')
    env.load(path)
    print(secrets.has('FAI_FIXTURE_SECRET'))
end
