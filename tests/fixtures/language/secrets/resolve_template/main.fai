# expect: ok
# stdout:
#   Bearer tmpl-tok-9
#   a-tmpl-tok-9-b
#   costs $5, key $FAI_FIXTURE_TMPL_UNSET
#   fallback
#   tmpl-tok-9

use std.secrets

use std.env

use std.file

def main
    @return Void
do
    let path = '/tmp/fai_std_secrets_tmpl.env'
    file.write(path, 'FAI_FIXTURE_TMPL=tmpl-tok-9\n')
    env.load(path)
    print(secrets.resolveTemplate('Bearer $FAI_FIXTURE_TMPL'))
    print(secrets.resolveTemplate('a-${FAI_FIXTURE_TMPL}-b'))
    print(secrets.resolveTemplate('costs $5, key $FAI_FIXTURE_TMPL_UNSET'))
    print(secrets.revealOr(secrets.get('FAI_FIXTURE_TMPL_UNSET'), 'fallback'))
    print(secrets.revealOr(secrets.get('FAI_FIXTURE_TMPL'), 'fallback'))
end
