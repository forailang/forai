# expect: check_error
# error: cannot be a Secret

use std.secrets

# A String-typed sink must not accept a Secret handle.
def send
    @param payload String
    @return Void
do
    print(payload)
end

test send
    it 'prints the payload'
        send('plain')
    end
end

def main
    @return Void
do
    let key = secrets.get('STRIPE_KEY')
    send(key)
end
