# expect: ok
# stdout:
#   hunter2
#   «secret FAI_FIXTURE_REVEAL»

use std.secrets

use std.env

use std.file

def main
    @return Void
do
    let path = '/tmp/fai_std_secrets_reveal.env'
    file.write(path, 'FAI_FIXTURE_REVEAL=hunter2\n')
    env.load(path)
    let key = secrets.get('FAI_FIXTURE_REVEAL')
    let plaintext = secrets.reveal(key)
    print(plaintext)
    print(key)
end
