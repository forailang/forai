# expect: ok
# stdout:
#   «secret bearer:STRIPE_KEY»
#   «secret basic:svc:STRIPE_KEY»
#   «secret STRIPE_KEY»
#   secret
# leak: flat
# ownership: balanced

use std.secrets

def main
    @return Void
do
    let key = secrets.get('STRIPE_KEY')
    print(secrets.bearer(key))
    print(secrets.basic('svc', key))
    print(secrets.header(key))
    print(typeOf(secrets.bearer(key)))
end
