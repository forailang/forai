# expect: ok
# stdout:
#   proc-token-123

use std.secrets

use std.env

use std.file

use std.process

use std.json

use std.string

def main
    @return Void
do
    let path = '/tmp/fai_std_secrets_proc.env'
    file.write(path, 'FAI_FIXTURE_PROC=proc-token-123\n')
    env.load(path)
    let key = secrets.get('FAI_FIXTURE_PROC')
    let envJson = json.stringify({
        MY_TOKEN: key
    })
    let raw = process.run('echo $MY_TOKEN', '', envJson, 5000, 65536)
    let result Dictionary = json.parse(raw)
    print(string.trim(getString(result, 'stdout')!))
end
