# expect: ok
# stdout:
#   3
#   1
#   hello
#   false
# Mixed-type literal binding to Unknown[] — `Unknown` is meant to
# accept anything, so widening Int/String/Bool elements into a
# Unknown[] should not be a type error.
def main
    @return Void
do
    let params Unknown[] = [
        1
        'hello'
        false
    ]
    print(length(params))
    print(toString(params[0]))
    print(toString(params[1]))
    print(toString(params[2]))
end
