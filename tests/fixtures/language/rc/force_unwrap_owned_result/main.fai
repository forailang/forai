# Ownership passes through `!`: force-unwrapping an owned-returning optional
# call (`json.requireString(...)!`, `json.query(...)!`) must transfer the
# callee's +1 to the binding instead of classifying it borrowed — which
# retained on bind and leaked the host-allocated result forever. Borrowed
# sources unwrapped with `!` keep their retain-on-bind behavior.
# expect: ok
# stdout:
#   hello
#   2
#   hi
# leak: flat
# ownership: balanced

use std.json

def main
    @return Void
do
    let name = json.requireString(json.parse('{"a":"hello"}'), 'a')!
    print(name)
    let matches = json.query('{"ns":[1,2]}', 'ns[]')!
    print(length(matches))
    let maybe String? = 'hi'
    let kept = maybe!
    print(kept)
end
