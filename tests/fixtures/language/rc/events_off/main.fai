# expect: ok
# stdout: ok
# leak: flat
#
# events.on retains the handler closure host-side; events.off releases
# that retained host credit when it removes the subscription.

use std.events

def main
    @return Void
do
    let sub = events.on('ping') do with e Event
        print('never')
    end
    events.off(sub)
    print('ok')
end
