# expect: ok
# stdout:
#   fired
#   ok
# leak: flat
#
# A `once` subscriber is dropped from the registry after it fires,
# releasing the retained host handler closure exactly once.

use std.events

def main
    @return Void
do
    events.once('ping') do with e Event
        print('fired')
    end
    events.emit('ping', 'x')
    print('ok')
end
