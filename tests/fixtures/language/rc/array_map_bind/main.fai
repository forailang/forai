# expect: ok
# stdout: ok
# leak: flat
#
# The map RESULT is handled correctly (bound, then released at scope
# exit) — what leaks are the call's owned BOXED ARG TEMPS: the input
# array literal and the callback closure (direct.rs arg-temp mop-up,
# plan 117 phase 4).

use std.array

def main
    @return Void
do
    let doubled = array.map([
        1
        2
        3
    ]) do with n Int
        n * 2
    end
    if doubled[2] == 6
        print('ok')
    end
end
