# expect: ok
# stdout: ok
# leak: flat
#
# clearAll releases every retained host subscription closure and any
# queued deferred payloads.

use std.events

def main
    @return Void
do
    events.on('a') do with e Event
        print('never-a')
    end
    events.on('b') do with e Event
        print('never-b')
    end
    events.clearAll()
    print('ok')
end
