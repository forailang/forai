# expect: ok
# browser:
#   selector: #http-result
#   text: 201 browser post payload

use std.browser

use std.http.request

use std.convert

def main
    @return Void
do
  let response = request.post('/__fai_fixture/http-post', 'payload')
  browser.setHtml('<div id="http-result">' + convert.toString(response.status) + ' ' + response.body + '</div>')
end
