# expect: ok
# stdout:
#   true
# Block.

type def Block
    @return Void
end

# Call block.
def call
    @param b Block
    @return Void
do
  b()
end

test call
it 'calls'
  call do

  end
  assert.isTrue(true)
end
end

def main
    @return Void
do
  var fired = false
  call do
      fired = true
  end
  print(fired)
end
