# expect: ok
# stdout:
#   10

type def Transform
    @param n Int
    @return Int
end

# Apply.
def apply
    @param cb Transform
    @param value Int
    @return Int
do
    cb(value)
end

test apply
    it 'applies transform'
        let r = apply(do with n Int
            n * 2
        end, 3)
        assert.equal(r, 6)
    end
end

def main
    @return Void
do
    let r = apply(do with n Int
        n * 2
    end, 5)
    print(r)
end
