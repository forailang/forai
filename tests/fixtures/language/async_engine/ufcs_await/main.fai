# expect: ok
# stdout:
#   42
# A UFCS call to an async fn (`x.doubled()` → `doubled(x)`) is detected as an
# await — `user_callee` resolves UFCS via `checker.ufcs_calls` and prepends the
# receiver. This is brain's `signal.reload()` shape.

type Sig
    val Int
end

# Async: sleeps then derives a value (UFCS-callable).
def doubled
    @param s Sig
    @return Int
do
    sleep(5)
    s.val * 2
end

def main
    @return Void
do
    let x = Sig(val: 21)
    let r = x.doubled()
    print(r)
end

test doubled
    it 'runs'
        let z = doubled(Sig(val: 1))
    end
end
