# expect: ok
# stdout:
#   42
# A closure-typed *parameter* called indirectly (`t()`) — the R4 case (brain's
# `loader()` shape). The closure passed here is async, so the call dispatches at
# runtime (frame_size>0) to spawn-and-await; a sync closure would dispatch to an
# inline call instead. Also exercises a 2-level await (main → callIt → closure).

type def Thunk
    @return Int
end

# Sleeps, then invokes the thunk parameter and returns its result.
def callIt
    @param t Thunk
    @return Int
do
    sleep(1)
    let r = t()
    r
end

def main
    @return Void
do
    let r = callIt do
        sleep(5)
        42
    end
    print(r)
end

test callIt
    it 'runs the thunk'
        let z = callIt do
            9
        end
    end
end
