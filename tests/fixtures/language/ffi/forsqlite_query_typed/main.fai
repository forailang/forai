# expect: ok
# stdout:
#   tasks=1
#   title=ship sqlite
#   done=1

use { open, close, exec, query_typed } from Forsqlite

type Task
  id Int
  title String
  done Int
end

def main
    @return Void
do
  let db = open(':memory:')
  exec(db, 'CREATE TABLE tasks (id INTEGER PRIMARY KEY, title TEXT, done INTEGER)')
  exec(db, "INSERT INTO tasks VALUES (1, 'ship sqlite', 1)")
  let tasks Task[] = query_typed(db, 'SELECT * FROM tasks ORDER BY id', [])
  print("tasks={{length(tasks)}}")
  print("title={{tasks[0].title}}")
  print("done={{tasks[0].done}}")
  close(db)
end
