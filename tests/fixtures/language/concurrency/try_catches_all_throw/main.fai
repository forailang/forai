# expect: ok
# stdout:
#   10
def main
    @return Int
do
    try
        let a, b = all(slow(), fast())
        99
    catch e
        10
    end
end

private:

# Returns after a slower wait.
def slow
    @return Int
do
    sleep(50)
    1
end

test slow
    it 'is covered by the async catch fixture'
        print('placeholder')
    end
end

# Throws after a faster wait.
def fast
    @return Int
do
    sleep(1)
    throw 9
end

test fast
    it 'is covered by the async catch fixture'
        print('placeholder')
    end
end
