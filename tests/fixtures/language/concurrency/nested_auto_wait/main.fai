# expect: ok
# stdout:
#   9
def main
    @return Int
do
    let y = parent()
    y + 1
end

private:

# Calls an async child and auto-waits its result.
def parent
    @return Int
do
    let x = child()
    x + 1
end

test parent
    it 'is covered by the nested async fixture'
        print('placeholder')
    end
end

# Returns after waiting.
def child
    @return Int
do
    sleep(1)
    7
end

test child
    it 'is covered by the nested async fixture'
        print('placeholder')
    end
end
