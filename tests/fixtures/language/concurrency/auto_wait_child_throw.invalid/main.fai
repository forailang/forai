# expect: runtime_error
# error: WASM async task failed: 7
def main
    @return Int
do
    let x = child()
    x + 1
end

private:

# Throws after waiting.
def child
    @return Int
do
    sleep(1)
    throw 7
end

test child
    it 'is covered by the async runtime fixture'
        print('placeholder')
    end
end
