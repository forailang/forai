# A module is a directory of .fai files. Import by directory name, not filename.
# All public declarations in all .fai files in that directory are exported together.
# Modules can be nested with subdirectories.
#
# ```text
# # File layout:
# # src/
# #   client/
# #     app.fai          # exports App
# #     components/
# #       nav.fai        # exports Nav
# #       section.fai    # exports Section
#
# # From any file inside src/client:
# use { App } from client
# use { Nav, Section } from client.components
#
# # Wrong: this looks for a client/app directory, not app.fai.
# use { App } from client.app
# ```
def doc_same_project
    @return Void
do

end

test doc_same_project
    it 'is documentation only'
        assert.equals(true, true)
    end
end

# External packages are declared in fai.toml [dependencies].
# The package name comes from the package's own fai.toml `name` field.
# Submodules are subdirectories inside the package source root.
#
# UFCS functions must be in file scope. Import the specific functions you use,
# or use an explicit glob import when the module is intentionally broad, such
# as Forui.view in UI files.
#
# ```toml
# [dependencies]
# Forui = "file:///path/to/forui"
# # or:
# Forui = "https://github.com/forailang/forui"
# ```
#
# ```fai
# use { mount } from Forui
# use * from Forui.view
# use { useSignal, isLoading } from Forui.signal
# use { navigate, Link } from Forui.router
#
# # This works because fontSize is in file scope from the glob import.
# Label('Hi').fontSize(18)
# ```
def doc_external_package
    @return Void
do

end

test doc_external_package
    it 'is documentation only'
        assert.equals(true, true)
    end
end

# Cross-target imports: when client and server targets share `source = "src"` in
# fai.toml, all directories under `src` are visible to both targets.
#
# ```text
# # src/platforms/server/main.fai importing client UI for SSR:
# use { App } from platforms.web
# ```
def doc_cross_target
    @return Void
do

end

test doc_cross_target
    it 'is documentation only'
        assert.equals(true, true)
    end
end

# In multi-target fullstack projects, client code imports remote functions from
# their real module path. The build replaces client-target calls to reachable
# `remote def` functions with generated RPC stubs.
#
# ```text
# use { Task, getTasks, addTask } from data.tasks
#
# var tasks = useSignal([]) do
#     getTasks()
# end
# ```
def doc_rpc_client
    @return Void
do

end

test doc_rpc_client
    it 'is documentation only'
        assert.equals(true, true)
    end
end

# The server exposes functions by marking them `remote def` and types
# `remote type`. The generated RPC route installer is injected automatically;
# do not define it
# yourself. Import the modules containing remote functions from the server
# entry so they are reachable.
#
# ```text
# use std.http.server
# use { handleRpcRequest } from Forui.rpc
# use { getTasks, addTask } from data.tasks
#
# def main
#     @return Void
# do
#     var r = server.router()
#     # Register generated RPC routes here after a full project build.
#     server.listen(r, 3040)
# end
# ```
def doc_rpc_server
    @return Void
do

end

test doc_rpc_server
    it 'is documentation only'
        assert.equals(true, true)
    end
end

# Declarations are public by default. The `private:` keyword makes all
# subsequent declarations in that file unexported.
#
# ```text
# def publicFn
#     @return Void
# do
# end
#
# private:
#
# def helper
#     @return Void
# do
# end
# ```
def doc_visibility
    @return Void
do

end

test doc_visibility
    it 'is documentation only'
        assert.equals(true, true)
    end
end
