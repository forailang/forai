# nowait — start background work and return immediately (fire and forget).
# Today this is a compatibility surface while scheduler-owned task
# records continue to expand.
def doc_nowait
    @return Void
do
  # nowait logEvent('page_viewed')
  # nowait sendWelcomeEmail(user.email)
end

# all() — run async-effectful tasks concurrently and resume when all complete.
# Results are returned as a tuple matching the source order of the calls.
def doc_all
    @return Void
do
  # let a, b = all(fetchUsers(), fetchPosts())   # parallel, both must succeed
  # let x, y, z = all(taskA(), taskB(), taskC())
end

# sleep() — pause the current task without blocking the host thread.
# Calls auto-await by default, so there is no `await`/`wait` keyword:
# `let x = someAsyncFunc()` already waits for the final value.
def doc_sleep
    @return Void
do
  # sleep(500)   # resume after at least 500 ms
end
