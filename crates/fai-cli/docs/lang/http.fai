  #   h = set(h, 'x-api-key', apiKey)
  #   let res = request.get('https://api.example.com/teams', headers: h)
  #   let body = json.parse(res.body)          # body is a Dictionary
  #   var teams Team[] = []
  #   # If the API returns `{"teams": [...]}`, body.teams is an Array.
  #   # Iterate the array directly — there is no `.items` wrapper.
  #   for item in body.teams
  #     let team = Team(
  #       id:   unwrap(getString(item, 'id'), ''),
  #       name: unwrap(getString(item, 'name'), ''),
  #     )
  #     teams = array.append(teams, team)
  #   end
  #   teams
  # end
end
