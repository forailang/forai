# Sort an array of primitives, or by extracted key for structs.
def doc_sort
    @return Void
do
  let nums = [3, 1, 4, 1, 5, 9, 2, 6]
  let sorted = array.sort(nums)
  # sorted = [1, 1, 2, 3, 4, 5, 6, 9]

  # For struct sorting, extract a comparable field first using map:
  # let tasks_by_id = array.sort(array.map(tasks, do with t Task t.id end))
end

test doc_sort
it 'sorts ascending'
  let nums = [3, 1, 4, 1, 5]
  let sorted = array.sort(nums)
  assert.equals(sorted[0], 1)
  assert.equals(sorted[4], 5)
end
end
