# Named functions use `@param`, `@return`, and `do...end`. A doc comment is
# required on every named function except `main`. `@type`, `@param`, and
# `@return` must appear in that order. Default values are declared inline on
# `@param`.
#
# ```fai
# def add
#     @param a Int
#     @param b Int
#     @return Int
# do
#     a + b
# end
#
# def greet
#     @param name String
#     @param greeting String, default: 'hello'
#     @return String
# do
#     "{{greeting}}, {{name}}"
# end
# ```
def doc_definition
    @return Void
do

end

test doc_definition
    it 'is documentation only'
        assert.equals(true, true)
    end
end

# Functions can be called with positional arguments, named arguments, or a mix.
# Named arguments can appear in any order after positional arguments.
#
# ```fai
# add(1, 2)
# greet(name: 'Alice')
# greet('Alice', greeting: 'hey')
# ```
def doc_calling
    @return Void
do

end

test doc_calling
    it 'is documentation only'
        assert.equals(true, true)
    end
end

# UFCS: any function can be called as a method on its first argument.
# A UFCS function must be in file scope. Use a named import for the specific
# function, or a glob import when the module is intentionally broad.
#
# ```fai
# # These are equivalent:
# add(5, 3)
# 5.add(3)
#
# # Both import styles put fontSize in file scope:
# use { fontSize } from Forui.view
# use * from Forui.view
#
# Label('Hi').fontSize(18)
# ```
def doc_ufcs
    @return Void
do

end

test doc_ufcs
    it 'is documentation only'
        assert.equals(true, true)
    end
end

# By default parameters are immutable copies. Mark a parameter `mutable` to let
# the function mutate the caller's binding in place. Only `var` bindings can be
# passed to mutable parameters.
#
# ```fai
# def increment
#     @param c Counter, mutable
#     @return Void
# do
#     c.value = c.value + 1
# end
#
# var c = Counter(value: 0)
# increment(c)
# ```
def doc_mutable_params
    @return Void
do

end

test doc_mutable_params
    it 'is documentation only'
        assert.equals(true, true)
    end
end

# Generic functions use `@type` to declare type parameters. The type argument is
# inferred at the call site.
#
# ```fai
# def echo
#     @type T
#     @param value T
#     @return T
# do
#     value
# end
#
# echo(42)
# echo('hello')
# ```
def doc_generics
    @return Void
do

end

test doc_generics
    it 'is documentation only'
        assert.equals(true, true)
    end
end

# Anonymous closures use `do...end`. Parameter types and return type are inferred
# from the `type def` they are matched against. Closures capture outer variables.
# The last function parameter can be passed as a trailing block.
#
# You can also chain UFCS modifiers directly on the result of a trailing-closure
# call.
#
# ```fai
# Button('Click', onClick: do
#     print('clicked')
# end)
#
# VStack do
#     Label('Hi')
# end
#     .padding(16)
#     .background('#fff')
# ```
def doc_closures
    @return Void
do

end

test doc_closures
    it 'closure captures outer variable'
        var total = 0
        let add = do with n Int
            total = total + n
        end
        add(5)
        add(3)
        assert.equals(total, 8)
    end
end
