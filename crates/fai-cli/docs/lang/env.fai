# std.env — process environment variables and dotenv loading.
#
# `env.get` reads a variable from the host process environment. On
# server/native targets it calls `std::env::var`. On browser builds
# (wasm-html) it returns null — the browser has no process env, so
# read deployment-specific values from build-time config instead.
#
# `env.load` parses a dotenv-style file and merges its entries into
# the process environment so subsequent `env.get` calls find them.
# It returns true on success, false when the file is missing or
# unreadable. Browser builds always return false.
#
# API
#   env.get(key: String) → String?          # null when unset
#   env.load(path: String) → Bool            # true on success
#
# File format (env.load)
#   - One `KEY=VALUE` pair per line.
#   - Lines starting with `#` are comments.
#   - Blank lines are skipped.
#   - Whitespace around `KEY` and `VALUE` is trimmed.
#   - If `VALUE` is wrapped in matching `"..."` or `'...'` the quotes
#     are stripped (no escape handling).
#   - Lines without `=` are skipped silently.
def doc_env_api
    @return Void
do
  # use std.env
  #
  # env.load('.env.dev')
  # let port = unwrap(env.get('SERVER_PORT'), '3040')
  # let dbUrl = unwrap(env.get('DATABASE_URL'), 'sqlite://db/dev.sqlite')
end

# Typical fullstack server startup. Load the appropriate `.env.*` file
# at the top of `main`, then read configuration with `env.get`. Keep
# secrets out of source — commit `.env.example`, not `.env.prod`.
def doc_env_server_startup
    @return Void
do
  # use std.env
  # use std.http.server
  # use std.convert
  #
  # def main
  #     @return Void
  # do
  #   env.load('.env.dev')
  #   let port = convert.toInt(unwrap(env.get('SERVER_PORT'), '3040'))
  #   var r = server.router()
  #   server.listen(r, port)
  # end
end

# Test fixtures should load `.env.testing` so they get isolated
# database paths and a distinct session secret. Never let tests
# reach into a developer's `.env.dev` or a deployed `.env.prod`.
def doc_env_test_isolation
    @return Void
do
  # use std.env
  #
  # test apiHandler
  # beforeAll
  #   env.load('.env.testing')
  # end
  # it 'reads the testing database url'
  #   assert.equals(env.get('DATABASE_URL')!, 'sqlite://db/test.sqlite')
  # end
  # end
end
